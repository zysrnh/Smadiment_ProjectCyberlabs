        <div class="xo-card-head-left"><div class="xo-head-ico" style="background:var(--amber-lt)"><svg style="stroke:var(--amber)" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></div><div><div class="xo-card-title">URL Table</div><div class="xo-card-sub">All shared links with frequency</div></div></div>
        <span class="xo-badge xo-badge--a" id="urlBadge">Loading…</span>
      </div>
      <div id="urlTableBody" class="xo-card-body--flush"><div class="xo-loading"><div class="spin-ring"></div>Memuat data URLs…</div></div>
    </div>
  </div>

  @endif
</div>

{{-- Mention detail modal --}}
<div class="xo-mention-modal" id="mentionModal">
  <div class="xo-mm-overlay" onclick="XOMention.close()"></div>
  <div class="xo-mm-content">
    <div class="xo-mm-header"><h3 id="mentionTitle">Mentions</h3><button class="xo-mm-close" onclick="XOMention.close()"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button></div>
    <div class="xo-mm-body" id="mentionBody"></div>
  </div>
</div>
@endsection

@section('scripts')
<script src="{{ asset('assets/js/plugins/apexcharts.min.js') }}"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
'use strict';

/* ═══════════════════════════════════════
   CONFIG
═══════════════════════════════════════ */
const CFG={
  pid:{{ $projectId ? (int)$projectId : 'null' }},
  sd:'{{ $startDate }}',ed:'{{ $endDate }}',
  api:'/mk/api/x/',
  perPage:10
};
const numFmt=n=>parseInt(n||0).toLocaleString('id-ID');
const numK=n=>{n=parseInt(n||0);return n>=1e6?(n/1e6).toFixed(1)+'M':n>=1e3?(n/1e3).toFixed(1)+'k':String(n);};
const esc=s=>(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const hideSk=id=>{const e=document.getElementById(id);if(e)e.style.display='none';};
const qp=()=>`project_id=${CFG.pid}&start_date=${CFG.sd}&end_date=${CFG.ed}`;
const Charts={};
let leafletMap=null;

/* ═══════════════════════════════════════
   DATE PICKER
═══════════════════════════════════════ */
const XODp=(()=>{
  let ds=null,de=null,m1=new Date(),m2=new Date(),pickStart=true;
  const MN=['January','February','March','April','May','June','July','August','September','October','November','December'];
  const WD=['Su','Mo','Tu','We','Th','Fr','Sa'];
  function init(){
    const si=document.getElementById('hSD'),ei=document.getElementById('hED');
    ds=si?.value?new Date(si.value):(()=>{const d=new Date();d.setDate(d.getDate()-6);return d;})();
    de=ei?.value?new Date(ei.value):new Date();
    m1=new Date(ds);m2=new Date(ds);m2.setMonth(m2.getMonth()+1);render();
    document.getElementById('dpTrigger')?.addEventListener('click',open);
    document.querySelectorAll('.dp-preset').forEach(b=>b.addEventListener('click',onPreset));
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&document.getElementById('dpModal').classList.contains('show'))close();});
  }
  function open(){document.getElementById('dpModal').classList.add('show');render();}
  function close(){document.getElementById('dpModal').classList.remove('show');}
  function apply(){document.getElementById('hSD').value=fmt(ds);document.getElementById('hED').value=fmt(de);document.getElementById('dpDisplay').textContent=fmt(ds)+' – '+fmt(de);close();document.getElementById('xoForm').submit();}
  function nav(d){m1.setMonth(m1.getMonth()+d);m2.setMonth(m2.getMonth()+d);render();}
  function onPreset(e){
    document.querySelectorAll('.dp-preset').forEach(b=>b.classList.remove('active'));e.target.classList.add('active');
    const today=new Date();today.setHours(0,0,0,0);
    switch(e.target.dataset.p){
      case'today':ds=new Date(today);de=new Date(today);break;
      case'yesterday':ds=new Date(today);ds.setDate(today.getDate()-1);de=new Date(ds);break;
      case'last7':de=new Date(today);ds=new Date(today);ds.setDate(today.getDate()-6);break;
      case'last30':de=new Date(today);ds=new Date(today);ds.setDate(today.getDate()-29);break;
      case'thismonth':ds=new Date(today.getFullYear(),today.getMonth(),1);de=new Date(today);break;
      case'lastmonth':ds=new Date(today.getFullYear(),today.getMonth()-1,1);de=new Date(today.getFullYear(),today.getMonth(),0);break;
    }
    if(e.target.dataset.p!=='custom'){m1=new Date(ds);m2=new Date(ds);m2.setMonth(m2.getMonth()+1);}
    updDisp();render();
  }
  function render(){renderCal('dpCal1',m1);renderCal('dpCal2',m2);updDisp();}
  function renderCal(id,month){
    const el=document.getElementById(id);if(!el)return;
    const y=month.getFullYear(),mn=month.getMonth();
    const first=new Date(y,mn,1),last=new Date(y,mn+1,0),prevL=new Date(y,mn,0);
    const today=new Date();today.setHours(0,0,0,0);
    let h=`<div class="dp-cal-month">${MN[mn]} ${y}</div><div class="dp-weekdays">${WD.map(d=>`<div class="dp-wd">${d}</div>`).join('')}</div><div class="dp-days">`;
    for(let i=0;i<first.getDay();i++)h+=`<button type="button" class="dp-day dp-other" disabled>${prevL.getDate()-(first.getDay()-1-i)}</button>`;
    for(let d=1;d<=last.getDate();d++){
      const date=new Date(y,mn,d);date.setHours(0,0,0,0);let cls='dp-day';
      if(sameD(date,today))cls+=' dp-today';if(ds&&de){if(sameD(date,ds)||sameD(date,de))cls+=' dp-sel';else if(date>ds&&date<de)cls+=' dp-range';}
      h+=`<button type="button" class="${cls}" data-date="${fmt(date)}">${d}</button>`;
    }
    const rem=last.getDay()===6?0:6-last.getDay();for(let i=1;i<=rem;i++)h+=`<button type="button" class="dp-day dp-other" disabled>${i}</button>`;
    h+='</div>';el.innerHTML=h;
    el.querySelectorAll('.dp-day:not(.dp-other):not(.dp-dis)').forEach(btn=>{
      btn.addEventListener('click',function(){
        const d=new Date(this.dataset.date);d.setHours(0,0,0,0);
        document.querySelectorAll('.dp-preset').forEach(b=>b.classList.remove('active'));
        document.querySelector('[data-p="custom"]').classList.add('active');
        if(pickStart||d<ds){ds=d;de=d;pickStart=false;}else{if(d>=ds)de=d;else{de=ds;ds=d;}pickStart=true;}
        updDisp();render();
      });
    });
  }
  function updDisp(){const el=document.getElementById('dpRangeText');if(el&&ds&&de)el.textContent=fmt(ds)+' – '+fmt(de);}
  function fmt(d){if(!d)return'';return`${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;}
  function sameD(a,b){return a&&b&&a.getFullYear()===b.getFullYear()&&a.getMonth()===b.getMonth()&&a.getDate()===b.getDate();}
  return{init,open,close,apply,nav};
})();

/* ═══════════════════════════════════════
   OVERVIEW STATS
═══════════════════════════════════════ */
const XOStats={
  async loadUsers(){
    try{const r=await(await fetch(`${CFG.api}total-users?${qp()}`)).json();
    if(r.success&&r.data)document.getElementById('kpiUsers').textContent=numFmt(r.data.total||0);
    }catch(e){console.error(e);document.getElementById('kpiUsers').textContent='—';}
  },
  async loadAuthors(){
    try{const r=await(await fetch(`${CFG.api}total-authors?${qp()}`)).json();
    if(r.success&&r.data)document.getElementById('kpiAuthors').textContent=numFmt(r.data.total||0);
    }catch(e){console.error(e);document.getElementById('kpiAuthors').textContent='—';}
  },
  async loadVolume(){
    try{const r=await(await fetch(`${CFG.api}volume-total?${qp()}`)).json();
    if(r.success&&r.data){
      document.getElementById('kpiVolume').textContent=numFmt(r.data.total||0);
      const chartData=r.data.chart||[];
      hideSk('skVolume');
      if(chartData.length){
        if(Charts.volume)try{Charts.volume.destroy();}catch(e){}
        const el=document.getElementById('chartVolume');el.innerHTML='';
        Charts.volume=new ApexCharts(el,{
          chart:{type:'area',height:280,fontFamily:"'Poppins',sans-serif",toolbar:{show:false},animations:{enabled:true,speed:600}},
          series:[{name:'Volume',data:chartData.map(d=>d.count||d.value||0)}],
          colors:['#038047'],
          fill:{type:'gradient',gradient:{shadeIntensity:1,opacityFrom:.45,opacityTo:.05,stops:[0,100]}},
          stroke:{curve:'smooth',width:3},
          xaxis:{categories:chartData.map(d=>d.date),labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',colors:'#94a3b8'},rotate:-30,rotateAlways:chartData.length>10},axisBorder:{show:false},axisTicks:{show:false}},
          yaxis:{labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',colors:'#94a3b8'},formatter:numK}},
          grid:{borderColor:'#f1f5f9',strokeDashArray:4},
          dataLabels:{enabled:false},
          tooltip:{y:{formatter:v=>numFmt(v)+' posts'},style:{fontFamily:"'Poppins',sans-serif"}}
        });Charts.volume.render();
      }
    }}catch(e){console.error(e);hideSk('skVolume');document.getElementById('kpiVolume').textContent='—';}
  },
  async loadSentiment(){
    try{const r=await(await fetch(`${CFG.api}sentiment-total?${qp()}`)).json();
    if(r.success&&r.data){
      const p=r.data.positive||0,u=r.data.neutral||0,n=r.data.negative||0,t=p+u+n;
      const score=t>0?((p*100+u*50)/t).toFixed(1):'0';
      document.getElementById('kpiSentiment').textContent=score+'%';
      hideSk('skSentiment');
      if(Charts.sentiment)try{Charts.sentiment.destroy();}catch(e){}
      const el=document.getElementById('chartSentiment');el.innerHTML='';
      Charts.sentiment=new ApexCharts(el,{
        chart:{type:'donut',height:280,fontFamily:"'Poppins',sans-serif"},
        series:[p,u,n],labels:['Positive','Neutral','Negative'],
        colors:['#10b981','#64748b','#ef4444'],
        plotOptions:{pie:{donut:{size:'60%',labels:{show:true,total:{show:true,label:'TOTAL',fontSize:'10px',fontWeight:700,color:'#94a3b8',formatter:w=>numFmt(w.globals.seriesTotals.reduce((a,b)=>a+b,0))},value:{fontSize:'24px',fontWeight:800,color:'#0f172a'}}}},expandOnClick:false},
        dataLabels:{enabled:false},
        legend:{position:'bottom',fontFamily:"'Poppins',sans-serif",fontSize:'12px',fontWeight:600,labels:{colors:'#64748b'}},
        stroke:{width:2,colors:['#fff']},
        tooltip:{y:{formatter:(v,opts)=>{const total=opts.globals.seriesTotals.reduce((a,b)=>a+b,0);return numFmt(v)+' ('+(total>0?(v/total*100).toFixed(1):0)+'%)';}},style:{fontFamily:"'Poppins',sans-serif"}}
      });Charts.sentiment.render();
    }}catch(e){console.error(e);hideSk('skSentiment');document.getElementById('kpiSentiment').textContent='—';}
  }
};

/* ═══════════════════════════════════════
   MOST ACTIVE USERS
═══════════════════════════════════════ */
const XOUsers={
  _all:[],
  async load(){
    try{const r=await(await fetch(`${CFG.api}most-active-users?${qp()}`)).json();
    if(r.success&&r.data&&r.data.data){
      this._all=r.data.data;
      document.getElementById('userBadge').textContent=this._all.length+' users';
      this._render(this._all.slice(0,20));
    }else{document.getElementById('usersBody').innerHTML='<div class="xo-empty"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span class="xo-empty-text">Tidak ada data</span></div>';}
    }catch(e){console.error(e);document.getElementById('usersBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Gagal memuat</span></div>';}
  },
  _render(users){
    if(!users.length){document.getElementById('usersBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Tidak ada data user</span></div>';return;}
    let h='<div style="overflow-x:auto"><table class="xo-table"><thead><tr><th>No</th><th></th><th>Username</th><th>Name</th><th>Posts</th><th>Retweets</th><th>Replies</th><th>Followers</th></tr></thead><tbody>';
    users.forEach((u,i)=>{
      const un=u.username||u.author||u.name||'Unknown';
      const name=u.contentJson?.name||u.name||un;
      const img=u.profile_url||u.profile_image_url||'';
      const ini=un.charAt(0).toUpperCase();
      const posts=u.posts||u.y||0,rts=u.retweets||0,reps=u.replies||0,fol=u.followers||u.contentJson?.followers_count||0;
      h+=`<tr style="cursor:pointer" onclick="XOMention.open('${esc(un.replace(/'/g,"\\'"))}')">
        <td><strong>${i+1}</strong></td>
        <td><div class="xo-av">${img?`<img src="${esc(img)}" alt="${esc(un)}" onerror="this.style.display='none';this.parentElement.textContent='${ini}'">`:(ini)}</div></td>
        <td><strong style="color:var(--dash-primary)">@${esc(un)}</strong></td>
        <td>${esc(name)}</td>
        <td>${numFmt(posts)}</td>
        <td>${numFmt(rts)}</td>
        <td>${numFmt(reps)}</td>
        <td>${numFmt(fol)}</td>
      </tr>`;
    });
    h+='</tbody></table></div>';
    document.getElementById('usersBody').innerHTML=h;
  },
  filter(q){
    q=q.toLowerCase().trim();
    if(!q){this._render(this._all.slice(0,20));return;}
    this._render(this._all.filter(u=>{const un=(u.username||u.author||u.name||'').toLowerCase();const nm=(u.contentJson?.name||u.name||'').toLowerCase();return un.includes(q)||nm.includes(q);}));
  }
};

/* ═══════════════════════════════════════
   TOP HASHTAGS
═══════════════════════════════════════ */
const XOHashtags={
  async load(){
    try{const r=await(await fetch(`${CFG.api}top-hashtags-data?${qp()}`)).json();
    if(r.success&&r.data){
      const ht=r.data.hashtags||[];
      document.getElementById('htBadge').textContent=ht.length+' hashtags';
      hideSk('skHashtags');
      // Chart
      const top10=ht.slice(0,10);
      if(top10.length){
        if(Charts.hashtags)try{Charts.hashtags.destroy();}catch(e){}
        const el=document.getElementById('chartHashtags');el.innerHTML='';
        Charts.hashtags=new ApexCharts(el,{
          chart:{type:'bar',height:300,fontFamily:"'Poppins',sans-serif",toolbar:{show:false}},
          series:[{name:'Mentions',data:top10.map(h=>h.size||0)}],
          colors:['#1d9bf0'],
          plotOptions:{bar:{borderRadius:8,columnWidth:'55%',dataLabels:{position:'top'}}},
          dataLabels:{enabled:true,formatter:v=>numK(v),offsetY:-20,style:{fontSize:'10px',fontWeight:'700',colors:['#64748b']}},
          xaxis:{categories:top10.map(h=>{const n=h.name||'';return n.length>12?n.slice(0,11)+'…':n;}),labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',fontWeight:'600',colors:'#64748b'},rotate:-30,rotateAlways:true},axisBorder:{show:false},axisTicks:{show:false}},
          yaxis:{labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',colors:'#94a3b8'},formatter:numK}},
          grid:{borderColor:'#f1f5f9',strokeDashArray:4},
          tooltip:{y:{formatter:v=>numFmt(v)+' mentions'},style:{fontFamily:"'Poppins',sans-serif"}}
        });Charts.hashtags.render();
      }
      // Table
      const maxSize=Math.max(...ht.map(h=>h.size||0),1);
      let th='<div style="overflow-x:auto;max-height:400px;overflow-y:auto"><table class="xo-table"><thead><tr><th>#</th><th>Hashtag</th><th>Mentions</th><th>Share</th><th>Volume</th></tr></thead><tbody>';
      const total=ht.reduce((s,h)=>s+(h.size||0),0)||1;
      ht.slice(0,30).forEach((h,i)=>{
        const pct=((h.size||0)/total*100).toFixed(1);
        const barW=((h.size||0)/maxSize*100).toFixed(0);
        th+=`<tr><td><strong>${i+1}</strong></td><td style="font-weight:700;color:var(--blue)">#${esc(h.name)}</td><td>${numFmt(h.size)}</td><td>${pct}%</td><td><div class="xo-ht-bar"><div class="xo-ht-bar-fill" style="width:${barW}%;background:linear-gradient(90deg,#1d9bf0,#0d8de0)"></div></div></td></tr>`;
      });
      th+='</tbody></table></div>';
      document.getElementById('htTableBody').innerHTML=th;
    }else{hideSk('skHashtags');document.getElementById('htTableBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Tidak ada data</span></div>';}
    }catch(e){console.error(e);hideSk('skHashtags');document.getElementById('htTableBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Gagal memuat</span></div>';}
  }
};

/* ═══════════════════════════════════════
   AUTHOR DEMOGRAPHICS
═══════════════════════════════════════ */
const XODemo={
  async loadAge(){
    try{const r=await(await fetch(`${CFG.api}authors-age?${qp()}`)).json();
    hideSk('skAge');
    const rows=r?.data?.rows||r?.rows||r?.data||[];if(!rows.length)return;
    const labels=[],vals=[];(Array.isArray(rows)?rows:[]).forEach(row=>{labels.push(row.age_group||row.label||'?');vals.push(parseInt(row.author_freq||row.value||0));});
    if(!labels.length)return;
    if(Charts.age)try{Charts.age.destroy();}catch(e){}
    const el=document.getElementById('chartAge');el.innerHTML='';
    Charts.age=new ApexCharts(el,{
      chart:{type:'bar',height:260,fontFamily:"'Poppins',sans-serif",toolbar:{show:false}},
      series:[{name:'Authors',data:vals}],colors:['#8b5cf6'],
      plotOptions:{bar:{borderRadius:6,columnWidth:'55%'}},
      dataLabels:{enabled:false},
      xaxis:{categories:labels,labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',fontWeight:'600',colors:'#64748b'}},axisBorder:{show:false},axisTicks:{show:false}},
      yaxis:{labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',colors:'#94a3b8'},formatter:numK}},
      grid:{borderColor:'#f1f5f9',strokeDashArray:4},
      tooltip:{y:{formatter:v=>numFmt(v)+' authors'},style:{fontFamily:"'Poppins',sans-serif"}}
    });Charts.age.render();
    }catch(e){console.error(e);hideSk('skAge');}
  },
  async loadGender(){
    try{const r=await(await fetch(`${CFG.api}authors-gender?${qp()}`)).json();
    hideSk('skGender');
    const rows=r?.data?.rows||r?.rows||r?.data||[];if(!rows.length)return;
    const labels=[],vals=[],colors=[];
    (Array.isArray(rows)?rows:[]).forEach(row=>{
      const g=(row.gender||row.label||'other').toLowerCase();
      labels.push(g.charAt(0).toUpperCase()+g.slice(1));vals.push(parseInt(row.author_freq||row.value||0));
      colors.push(g.includes('male')&&!g.includes('female')?'#3b82f6':g.includes('female')?'#ec4899':'#94a3b8');
    });
    if(!labels.length)return;
    if(Charts.gender)try{Charts.gender.destroy();}catch(e){}
    const el=document.getElementById('chartGender');el.innerHTML='';
    Charts.gender=new ApexCharts(el,{
      chart:{type:'donut',height:260,fontFamily:"'Poppins',sans-serif"},
      series:vals,labels:labels,colors:colors,
      plotOptions:{pie:{donut:{size:'55%',labels:{show:true,total:{show:true,label:'TOTAL',fontSize:'10px',fontWeight:700,color:'#94a3b8',formatter:w=>numFmt(w.globals.seriesTotals.reduce((a,b)=>a+b,0))},value:{fontSize:'22px',fontWeight:800,color:'#0f172a'}}}},expandOnClick:false},
      dataLabels:{enabled:true,formatter:(val)=>val<2?'':val.toFixed(0)+'%',style:{fontFamily:"'Poppins',sans-serif",fontSize:'11px',fontWeight:'700'},dropShadow:{enabled:false}},
      legend:{position:'bottom',fontFamily:"'Poppins',sans-serif",fontSize:'11px',fontWeight:600,labels:{colors:'#64748b'}},
      stroke:{width:2,colors:['#fff']},
      tooltip:{y:{formatter:v=>numFmt(v)+' authors'},style:{fontFamily:"'Poppins',sans-serif"}}
    });Charts.gender.render();
    }catch(e){console.error(e);hideSk('skGender');}
  },
  async loadType(){
    try{const r=await(await fetch(`${CFG.api}authors-type?${qp()}`)).json();
    hideSk('skType');
    const rows=r?.data?.rows||r?.rows||r?.data||[];if(!rows.length)return;
    const labels=[],vals=[];
    (Array.isArray(rows)?rows:[]).forEach(row=>{labels.push(row.type||row.label||'?');vals.push(parseInt(row.author_freq||row.value||0));});
    if(!labels.length)return;
    if(Charts.authorType)try{Charts.authorType.destroy();}catch(e){}
    const el=document.getElementById('chartType');el.innerHTML='';
    Charts.authorType=new ApexCharts(el,{
      chart:{type:'donut',height:260,fontFamily:"'Poppins',sans-serif"},
      series:vals,labels:labels,colors:['#8b5cf6','#06b6d4','#f59e0b','#ef4444','#10b981'],
      plotOptions:{pie:{donut:{size:'55%'}},expandOnClick:false},
      dataLabels:{enabled:true,formatter:(val)=>val<2?'':val.toFixed(0)+'%',style:{fontFamily:"'Poppins',sans-serif",fontSize:'11px',fontWeight:'700'},dropShadow:{enabled:false}},
      legend:{position:'bottom',fontFamily:"'Poppins',sans-serif",fontSize:'11px',fontWeight:600,labels:{colors:'#64748b'}},
      stroke:{width:2,colors:['#fff']},
      tooltip:{y:{formatter:v=>numFmt(v)+' authors'},style:{fontFamily:"'Poppins',sans-serif"}}
    });Charts.authorType.render();
    }catch(e){console.error(e);hideSk('skType');}
  }
};

/* ═══════════════════════════════════════
   GEOGRAPHIC
═══════════════════════════════════════ */
const XOGeo={
  async load(){
    try{
      const [geoR,locR]=await Promise.all([
        fetch(`${CFG.api}geo-user?${qp()}`).then(r=>r.json()),
        fetch(`${CFG.api}top-locations?${qp()}`).then(r=>r.json())
      ]);
      // Map
      hideSk('skMap');
      const geoData=geoR?.data||geoR||{};
      const rows=geoData?.countries?.rows||geoData?.rows||[];
      if(leafletMap){leafletMap.remove();leafletMap=null;}
      leafletMap=L.map('mapGeo',{scrollWheelZoom:false}).setView([-2.5,118],4);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{attribution:'© OSM',maxZoom:18}).addTo(leafletMap);
      if(rows.length){
        const geocodeCache={'indonesia':[-2.5,118],'united states':[39.8,-98.6],'japan':[36.2,138.2],'south korea':[35.9,127.7],'malaysia':[4.2,101.9],'singapore':[1.35,103.8],'thailand':[15.9,100.9],'philippines':[12.8,121.7],'india':[20.6,78.9],'australia':[-25.3,134],'united kingdom':[55.4,-3.4],'germany':[51.2,10.4],'france':[46.2,2.2],'brazil':[-14.2,-51.9],'canada':[56.1,-106.3]};
        rows.forEach(r=>{
          const name=(r.name||'').toLowerCase();const count=parseInt(r.count||r.value||0);
          const coords=geocodeCache[name];
          if(coords){
            L.circleMarker(coords,{radius:Math.min(6+Math.sqrt(count)*2,25),fillColor:'#038047',color:'#fff',weight:2,opacity:1,fillOpacity:.7}).addTo(leafletMap).bindPopup(`<strong>${esc(r.name)}</strong><br>${numFmt(count)} users`);
          }
        });
      }
      setTimeout(()=>{if(leafletMap)leafletMap.invalidateSize();},300);

      // Top Locations table
      const locations=locR?.data||locR||[];
      document.getElementById('geoBadge').textContent=(Array.isArray(locations)?locations.length:0)+' locations';
      if(Array.isArray(locations)&&locations.length){
        let h='<div style="overflow-x:auto;max-height:400px;overflow-y:auto"><table class="xo-table"><thead><tr><th>#</th><th>Location</th><th>Users</th></tr></thead><tbody>';
        locations.slice(0,30).forEach((l,i)=>{
          h+=`<tr><td><strong>${i+1}</strong></td><td style="font-weight:600">${esc(l.name||l.location||'Unknown')}</td><td>${numFmt(l.count||l.value||0)}</td></tr>`;
        });
        h+='</tbody></table></div>';
        document.getElementById('geoTableBody').innerHTML=h;
      }else{document.getElementById('geoTableBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Tidak ada data lokasi</span></div>';}
    }catch(e){console.error(e);hideSk('skMap');document.getElementById('geoTableBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Gagal memuat</span></div>';}
  }
};

/* ═══════════════════════════════════════
   POSTS WITH LOCATION
═══════════════════════════════════════ */
const XOLocPosts={
  _all:[],_page:1,
  async load(){
    try{const r=await(await fetch(`${CFG.api}post-with-location?${qp()}`)).json();
    const items=r?.data||[];this._all=Array.isArray(items)?items:[];
    document.getElementById('locPostsBadge').textContent=this._all.length+' posts';
    this._page=1;this._render();
    }catch(e){console.error(e);document.getElementById('locPostsBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Gagal memuat</span></div>';}
  },
  _render(){
    const listEl=document.getElementById('locPostsBody'),pagEl=document.getElementById('locPostsPag');
    if(!this._all.length){listEl.innerHTML='<div class="xo-empty"><span class="xo-empty-text">Tidak ada posts dengan lokasi</span></div>';pagEl.innerHTML='';return;}
    const total=this._all.length,pp=CFG.perPage,pages=Math.ceil(total/pp),start=(this._page-1)*pp;
    const slice=this._all.slice(start,start+pp);
    let h='<div style="overflow-x:auto"><table class="xo-table"><thead><tr><th>#</th><th>Author</th><th>Content</th><th>Location</th><th>Sentiment</th><th>Date</th></tr></thead><tbody>';
    slice.forEach((p,i)=>{
      const author=p.author_scr_name||p.author?.scr_name||p.name||'Unknown';
      const content=(p.content||'').replace(/<[^>]*>/g,'').trim();
      const loc=p.location||'Unknown';
      const sentRaw=String(p.class_sentiment_label||p.sentiment_str||'').toLowerCase();
      const sent=sentRaw.includes('pos')?'pos':sentRaw.includes('neg')?'neg':'neu';
      const sentLbl=sent==='pos'?'Positive':sent==='neg'?'Negative':'Neutral';
      const dt=(p.date_created||'').split('T')[0];
      h+=`<tr>
        <td><strong>${start+i+1}</strong></td>
        <td><strong style="color:var(--dash-primary)">@${esc(author)}</strong></td>
        <td style="max-width:300px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${esc(content.substring(0,80))}</td>
        <td style="white-space:nowrap">${esc(loc)}</td>
        <td><span class="xo-sent xo-sent--${sent}">${sentLbl}</span></td>
        <td style="white-space:nowrap">${dt}</td>
      </tr>`;
    });
    h+='</tbody></table></div>';
    listEl.innerHTML=h;
    // Pagination
    if(pages<=1){pagEl.innerHTML='';return;}
    const from=start+1,to=Math.min(start+pp,total);
    let ph=`<div class="xo-pag"><span class="xo-pag-info">Menampilkan ${from}–${to} dari ${total}</span><div class="xo-pag-ctrls">`;
    ph+=`<button class="xo-pag-btn" ${this._page<=1?'disabled':''} onclick="XOLocPosts.go(${this._page-1})"><svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></button>`;
    for(let pg=1;pg<=pages;pg++){if(pg===1||pg===pages||(pg>=this._page-2&&pg<=this._page+2))ph+=`<button class="xo-pag-btn${pg===this._page?' is-active':''}" onclick="XOLocPosts.go(${pg})">${pg}</button>`;else if(pg===this._page-3||pg===this._page+3)ph+=`<span class="xo-pag-btn" style="cursor:default;opacity:.5">…</span>`;}
    ph+=`<button class="xo-pag-btn" ${this._page>=pages?'disabled':''} onclick="XOLocPosts.go(${this._page+1})"><svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></button></div></div>`;
    pagEl.innerHTML=ph;
  },
  go(p){this._page=p;this._render();document.getElementById('locPostsBody').scrollIntoView({behavior:'smooth',block:'nearest'});},
  exportCsv(){
    if(!this._all.length){alert('Tidak ada data.');return;}
    const header='no;author;content;location;sentiment;date';
    const rows=this._all.map((p,i)=>{
      const author=p.author_scr_name||p.author?.scr_name||p.name||'Unknown';
      const content=(p.content||'').replace(/<[^>]*>/g,'').replace(/\n/g,' ').trim();
      const loc=p.location||'';
      const sentRaw=String(p.class_sentiment_label||p.sentiment_str||'').toLowerCase();
      const sent=sentRaw.includes('pos')?'Positif':sentRaw.includes('neg')?'Negatif':'Netral';
      return[i+1,'@'+author,`"${content.replace(/"/g,'""')}"`,`"${loc.replace(/"/g,'""')}"`,sent,(p.date_created||'').split('T')[0]].join(';');
    });
    const csv=header+'\n'+rows.join('\n');
    const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});
    const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=`x-posts-location-${CFG.sd}-to-${CFG.ed}.csv`;a.click();URL.revokeObjectURL(a.href);
  }
};

/* ═══════════════════════════════════════
   SHARED URLS
═══════════════════════════════════════ */
const XOUrls={
  async load(){
    try{const r=await(await fetch(`${CFG.api}shared-urls?${qp()}`)).json();
    const urls=r?.data||[];const items=Array.isArray(urls)?urls:[];
    document.getElementById('urlBadge').textContent=items.length+' URLs';
    hideSk('skUrls');
    // Chart
    const top10=items.slice(0,10);
    if(top10.length){
      if(Charts.urls)try{Charts.urls.destroy();}catch(e){}
      const el=document.getElementById('chartUrls');el.innerHTML='';
      Charts.urls=new ApexCharts(el,{
        chart:{type:'bar',height:300,fontFamily:"'Poppins',sans-serif",toolbar:{show:false}},
        series:[{name:'Shares',data:top10.map(u=>parseInt(u.freq||0))}],
        colors:['#f59e0b'],
        plotOptions:{bar:{borderRadius:8,columnWidth:'55%',dataLabels:{position:'top'}}},
        dataLabels:{enabled:true,formatter:v=>numK(v),offsetY:-20,style:{fontSize:'10px',fontWeight:'700',colors:['#64748b']}},
        xaxis:{categories:top10.map(u=>{try{return new URL(u.url).hostname.replace('www.','');}catch(e){return(u.url||'').substring(0,15);}}),labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'9px',fontWeight:'600',colors:'#64748b'},rotate:-30,rotateAlways:true},axisBorder:{show:false},axisTicks:{show:false}},
        yaxis:{labels:{style:{fontFamily:"'Poppins',sans-serif",fontSize:'10px',colors:'#94a3b8'},formatter:numK}},
        grid:{borderColor:'#f1f5f9',strokeDashArray:4},
        tooltip:{y:{formatter:v=>numFmt(v)+' shares'},style:{fontFamily:"'Poppins',sans-serif"}}
      });Charts.urls.render();
    }
    // Table
    if(items.length){
      let h='<div style="overflow-x:auto;max-height:400px;overflow-y:auto"><table class="xo-table"><thead><tr><th>#</th><th>URL</th><th>Hostname</th><th>Freq</th></tr></thead><tbody>';
      items.slice(0,30).forEach((u,i)=>{
        let host='';try{host=new URL(u.url).hostname.replace('www.','');}catch(e){host='';}
        h+=`<tr><td><strong>${i+1}</strong></td><td style="max-width:250px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis"><a href="${esc(u.url)}" target="_blank" rel="noopener" style="color:var(--amber);text-decoration:none;font-weight:600">${esc(u.url)}</a></td><td style="white-space:nowrap">${esc(host)}</td><td><strong>${numFmt(u.freq)}</strong></td></tr>`;
      });
      h+='</tbody></table></div>';
      document.getElementById('urlTableBody').innerHTML=h;
    }else{document.getElementById('urlTableBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Tidak ada data URLs</span></div>';}
    }catch(e){console.error(e);hideSk('skUrls');document.getElementById('urlTableBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Gagal memuat</span></div>';}
  }
};

/* ═══════════════════════════════════════
   MENTION MODAL
═══════════════════════════════════════ */
const XOMention={
  async open(username){
    document.getElementById('mentionTitle').textContent='Mentions of @'+username;
    document.getElementById('mentionBody').innerHTML='<div class="xo-loading"><div class="spin-ring"></div>Memuat mentions…</div>';
    document.getElementById('mentionModal').classList.add('show');
    try{
      const r=await(await fetch(`${CFG.api}user-mentions?${qp()}&username=${encodeURIComponent(username)}`)).json();
      if(r.success&&r.data&&r.data.mentions){
        const mentions=r.data.mentions;
        if(!mentions.length){document.getElementById('mentionBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Tidak ada mentions</span></div>';return;}
        let h='';
        mentions.forEach(m=>{
          const text=m.text||m.content||'No content';
          const dt=m.created_at||m.date||'';
          const sentRaw=(m.sentiment||'neutral').toLowerCase();
          const sent=sentRaw.includes('pos')?'pos':sentRaw.includes('neg')?'neg':'neu';
          const sentLbl=sent==='pos'?'Positive':sent==='neg'?'Negative':'Neutral';
          h+=`<div class="xo-mm-item"><div class="xo-mm-item-head"><span class="xo-mm-item-meta">${dt}</span><span class="xo-sent xo-sent--${sent}">${sentLbl}</span></div><div class="xo-mm-item-text">${esc(text)}</div></div>`;
        });
        document.getElementById('mentionBody').innerHTML=h;
      }else{document.getElementById('mentionBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Gagal memuat</span></div>';}
    }catch(e){console.error(e);document.getElementById('mentionBody').innerHTML='<div class="xo-empty"><span class="xo-empty-text">Error: '+e.message+'</span></div>';}
  },
  close(){document.getElementById('mentionModal').classList.remove('show');}
};
document.addEventListener('keydown',e=>{if(e.key==='Escape')XOMention.close();});

/* ═══════════════════════════════════════
   MAIN INIT
═══════════════════════════════════════ */
const XO={
  init(){
    XODp.init();
    if(!CFG.pid)return;
    // Fire all independent API calls in parallel
    XOStats.loadUsers();
    XOStats.loadAuthors();
    XOStats.loadVolume();
    XOStats.loadSentiment();
    XOUsers.load();
    XOHashtags.load();
    XODemo.loadAge();
    XODemo.loadGender();
    XODemo.loadType();
    XOGeo.load();
    XOLocPosts.load();
    XOUrls.load();
  },
  reload(){location.reload();}
};
document.addEventListener('DOMContentLoaded',()=>XO.init());
</script>
@endsection
