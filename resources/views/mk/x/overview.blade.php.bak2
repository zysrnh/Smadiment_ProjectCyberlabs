@extends('mk.layouts.app')

@section('title', 'X Overview - SMADIMENT')

@section('styles')
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
/* ══ Design Tokens ══ */
:root{
  --dash-primary:#038047;--dash-primary-dark:#026738;
  --dash-primary-rgb:3,128,71;--dash-primary-lt:rgba(3,128,71,.10);
  --blue:#1d9bf0;--blue-lt:rgba(29,155,240,.08);
  --green:#10b981;--green-lt:#ecfdf5;
  --red:#ef4444;--red-lt:#fef2f2;
  --purple:#8b5cf6;--purple-lt:rgba(139,92,246,.08);
  --amber:#f59e0b;--amber-lt:rgba(245,158,11,.08);
  --slate-50:#f8fafc;--slate-100:#f1f5f9;--slate-200:#e2e8f0;--slate-300:#cbd5e1;
  --slate-400:#94a3b8;--slate-500:#64748b;--slate-600:#475569;--slate-700:#334155;
  --slate-800:#1e293b;--slate-900:#0f172a;
  --radius:16px;--radius-sm:12px;--radius-xs:8px;
  --shadow-sm:0 1px 3px rgba(15,23,42,.06),0 1px 2px rgba(15,23,42,.04);
  --shadow-md:0 4px 14px rgba(15,23,42,.08);
  --shadow-lg:0 10px 30px rgba(15,23,42,.12);
  --font:'Poppins',-apple-system,sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font);color:var(--slate-900);}

/* ══ Animations ══ */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}
@keyframes spin{to{transform:rotate(360deg)}}

.fade-up{animation:fadeUp .38s ease-out both}
.fade-d1{animation-delay:.05s}.fade-d2{animation-delay:.10s}.fade-d3{animation-delay:.15s}.fade-d4{animation-delay:.20s}

.sk-block{border-radius:4px;background:linear-gradient(90deg,var(--slate-100) 25%,var(--slate-200) 50%,var(--slate-100) 75%);background-size:200% 100%;animation:shimmer 1.4s infinite}
.spin-ring{width:26px;height:26px;border:2.5px solid var(--slate-100);border-top-color:var(--dash-primary);border-radius:50%;animation:spin .65s linear infinite}

/* ══ Page Container ══ */
.xo-page{padding:24px;max-width:1600px;margin:0 auto;min-height:100vh}

/* ══ Page Header ══ */
.xo-page-header{display:flex;align-items:flex-start;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px}
.xo-page-header h1{font-size:28px;font-weight:700;color:var(--slate-900);margin:0 0 6px;letter-spacing:-.4px;display:flex;align-items:center;gap:10px}
.xo-page-header h1 .x-ico{width:32px;height:32px;background:#000;border-radius:8px;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.xo-page-header h1 .x-ico svg{width:17px;height:17px;fill:#fff}
.xo-page-header p{font-size:14px;color:var(--slate-500);font-weight:500;margin:0}
.xo-refresh-btn{display:flex;align-items:center;gap:8px;padding:10px 20px;background:linear-gradient(135deg,#1a202c,#2d3748);color:#fff;border:none;border-radius:var(--radius-sm);font-family:var(--font);font-size:13px;font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 4px 14px rgba(0,0,0,.2)}
.xo-refresh-btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(0,0,0,.25)}
.xo-refresh-btn svg{width:15px;height:15px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}

/* ══ Filter Card ══ */
.xo-filter{background:#fff;border-radius:var(--radius);padding:20px 24px;margin-bottom:24px;box-shadow:var(--shadow-sm);border:1px solid var(--slate-200)}
.xo-filter-row{display:flex;align-items:flex-end;gap:16px;flex-wrap:wrap}
.xo-filter-group{display:flex;flex-direction:column;gap:6px}
.xo-filter-label{font-size:11px;font-weight:700;color:var(--slate-500);text-transform:uppercase;letter-spacing:.5px}
.xo-filter-select{padding:10px 14px;border:1px solid var(--slate-200);border-radius:var(--radius-sm);font-family:var(--font);font-size:14px;font-weight:500;color:var(--slate-900);background:var(--slate-50);outline:none;transition:all .2s;min-width:200px;cursor:pointer}
.xo-filter-select:focus{border-color:var(--dash-primary);background:#fff;box-shadow:0 0 0 3px var(--dash-primary-lt)}
.dp-trigger{display:flex;align-items:center;gap:10px;padding:10px 16px;background:var(--slate-50);border:1px solid var(--slate-200);border-radius:var(--radius-sm);font-family:var(--font);font-size:14px;font-weight:500;color:var(--slate-900);cursor:pointer;transition:all .2s;min-width:300px}
.dp-trigger:hover{border-color:var(--dash-primary);background:#fff;box-shadow:0 0 0 3px var(--dash-primary-lt)}
.dp-trigger svg{width:16px;height:16px;color:var(--slate-500);flex-shrink:0}
.dp-trigger span{flex:1;text-align:left}
.xo-apply-btn{display:flex;align-items:center;gap:8px;padding:10px 24px;background:linear-gradient(135deg,var(--dash-primary),var(--dash-primary-dark));color:#fff;border:none;border-radius:var(--radius-sm);font-family:var(--font);font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;box-shadow:0 4px 12px rgba(3,128,71,.2);white-space:nowrap}
.xo-apply-btn:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(3,128,71,.3)}
.xo-apply-btn svg{width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2.5;stroke-linecap:round}

/* ══ Date Picker Modal ══ */
.dp-modal{position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.5);backdrop-filter:blur(8px)}
.dp-modal.show{display:flex}
.dp-overlay{position:absolute;inset:0;cursor:pointer}
.dp-container{position:relative;z-index:1;background:#fff;border-radius:var(--radius);box-shadow:0 25px 50px rgba(0,0,0,.3);display:flex;max-width:900px;width:90%;max-height:90vh;animation:fadeUp .3s ease-out}
.dp-sidebar{width:180px;background:var(--slate-50);border-right:1px solid var(--slate-200);padding:16px 12px;border-radius:var(--radius) 0 0 var(--radius);display:flex;flex-direction:column;gap:4px;flex-shrink:0}
.dp-preset{padding:10px 16px;background:transparent;border:none;border-radius:var(--radius-xs);font-family:var(--font);font-size:13px;font-weight:500;color:var(--slate-900);text-align:left;cursor:pointer;transition:all .2s}
.dp-preset:hover{background:#fff;color:var(--dash-primary)}
.dp-preset.active{background:var(--dash-primary);color:#fff}
.dp-content{flex:1;padding:24px;display:flex;flex-direction:column;overflow:hidden}
.dp-header{display:flex;align-items:flex-start;gap:20px;margin-bottom:20px}
.dp-nav{width:36px;height:36px;border-radius:var(--radius-xs);background:var(--slate-50);border:1px solid var(--slate-200);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .2s;flex-shrink:0}
.dp-nav:hover{background:var(--dash-primary);border-color:var(--dash-primary);color:#fff}
.dp-nav svg{width:20px;height:20px}
.dp-cals{display:flex;gap:24px;flex:1}
.dp-cal{flex:1;display:flex;flex-direction:column}
.dp-cal-month{font-size:16px;font-weight:700;color:var(--slate-900);margin-bottom:16px;text-align:center}
.dp-weekdays{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-bottom:8px}
.dp-wd{text-align:center;font-size:11px;font-weight:700;color:var(--slate-500);padding:8px 0}
.dp-days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px}
.dp-day{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:500;border-radius:var(--radius-xs);cursor:pointer;transition:all .15s;color:var(--slate-900);background:transparent;border:none;padding:0;font-family:var(--font)}
.dp-day:hover:not(.dp-other):not(.dp-dis){background:var(--slate-100)}
.dp-other{color:#cbd5e1;cursor:default}
.dp-dis{color:#e2e8f0;cursor:not-allowed}
.dp-today{border:2px solid var(--dash-primary)}
.dp-sel{background:var(--dash-primary);color:#fff}
.dp-range{background:var(--dash-primary-lt);color:var(--dash-primary)}
.dp-display{padding:16px 20px;background:var(--slate-50);border-radius:var(--radius-sm);text-align:center;margin-bottom:20px;border:1px solid var(--slate-200)}
.dp-display span{font-size:14px;font-weight:600;color:var(--slate-900)}
.dp-footer{display:flex;gap:12px;justify-content:flex-end}
.dp-cancel{padding:10px 24px;border-radius:10px;font-family:var(--font);font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;border:none;background:var(--slate-100);color:var(--slate-900)}
.dp-cancel:hover{background:var(--slate-200)}
.dp-apply-date{padding:10px 24px;border-radius:10px;font-family:var(--font);font-size:14px;font-weight:600;cursor:pointer;transition:all .2s;border:none;background:linear-gradient(135deg,var(--dash-primary),var(--dash-primary-dark));color:#fff;box-shadow:0 4px 12px rgba(3,128,71,.2)}
.dp-apply-date:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(3,128,71,.3)}

/* ══ Section Divider ══ */
.xo-section{display:flex;align-items:center;gap:10px;margin:28px 0 16px}
.xo-section-ico{width:36px;height:36px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.xo-section-ico svg{width:18px;height:18px;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.xo-section-title{font-size:13px;font-weight:700;color:var(--slate-500);text-transform:uppercase;letter-spacing:.8px}
.xo-section-line{flex:1;height:1.5px;background:var(--slate-200);border-radius:1px}

/* ══ KPI Cards ══ */
.xo-kpi-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:20px}
.xo-kpi{background:#fff;border:1px solid var(--slate-200);border-radius:var(--radius);padding:20px 22px;box-shadow:var(--shadow-sm);transition:all .2s;position:relative;overflow:hidden;cursor:default}
.xo-kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;opacity:0;transition:opacity .25s}
.xo-kpi:hover{box-shadow:var(--shadow-lg);transform:translateY(-2px)}
.xo-kpi:hover::before{opacity:1}
.xo-kpi--g::before{background:linear-gradient(90deg,var(--dash-primary),var(--dash-primary-dark))}
.xo-kpi--b::before{background:linear-gradient(90deg,var(--blue),#0d8de0)}
.xo-kpi--r::before{background:linear-gradient(90deg,var(--red),#dc2626)}
.xo-kpi--p::before{background:linear-gradient(90deg,var(--purple),#7c3aed)}
.xo-kpi--a::before{background:linear-gradient(90deg,var(--amber),#d97706)}
.xo-kpi-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.xo-kpi-ico{width:44px;height:44px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.xo-kpi-ico svg{width:22px;height:22px;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.xo-kpi-label{font-size:11px;font-weight:700;color:var(--slate-400);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
.xo-kpi-val{font-size:28px;font-weight:700;color:var(--slate-900);letter-spacing:-1px;line-height:1;min-height:36px;display:flex;align-items:center}
.xo-kpi-sub{font-size:11px;color:var(--slate-400);font-weight:500;margin-top:6px}

/* ══ Card ══ */
.xo-card{background:#fff;border:1px solid var(--slate-200);border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);transition:all .2s;position:relative}
.xo-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--dash-primary),var(--dash-primary-dark));opacity:0;transition:opacity .3s}
.xo-card:hover{box-shadow:var(--shadow-md)}
.xo-card:hover::before{opacity:1}
.xo-card--b::before{background:linear-gradient(90deg,var(--blue),#0d8de0)}
.xo-card--r::before{background:linear-gradient(90deg,var(--red),#dc2626)}
.xo-card--p::before{background:linear-gradient(90deg,var(--purple),#7c3aed)}
.xo-card--a::before{background:linear-gradient(90deg,var(--amber),#d97706)}
.xo-card--ink::before{background:linear-gradient(90deg,#1a202c,#334155)}
.xo-card-head{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--slate-200);flex-shrink:0;gap:12px;flex-wrap:wrap}
.xo-card-head-left{display:flex;align-items:center;gap:12px;min-width:0}
.xo-head-ico{width:40px;height:40px;border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.xo-head-ico svg{width:20px;height:20px;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.xo-card-title{font-size:15px;font-weight:700;color:var(--slate-900);line-height:1.3}
.xo-card-sub{font-size:11px;color:var(--slate-400);font-weight:500;margin-top:2px}
.xo-badge{display:inline-flex;align-items:center;padding:4px 12px;border-radius:20px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;white-space:nowrap;flex-shrink:0}
.xo-badge--g{background:#d1fae5;color:#065f46}
.xo-badge--b{background:#dbeafe;color:#1e40af}
.xo-badge--r{background:#fee2e2;color:#991b1b}
.xo-badge--p{background:#ede9fe;color:#5b21b6}
.xo-badge--a{background:#fef3c7;color:#92400e}
.xo-badge--muted{background:var(--slate-100);color:var(--slate-500)}
.xo-card-body{padding:20px;flex:1}
.xo-card-body--flush{padding:0}

/* ══ Grids ══ */
.xo-grid-2{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px}
.xo-grid-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;margin-bottom:20px}
.xo-mb20{margin-bottom:20px}

/* Charts */
.xo-ch{position:relative}
.xo-ch-280{height:280px}.xo-ch-300{height:300px}.xo-ch-320{height:320px}.xo-ch-400{height:400px}

/* ══ Table ══ */
.xo-table{width:100%;border-collapse:separate;border-spacing:0;font-size:12px}
.xo-table thead tr{background:var(--slate-50)}
.xo-table th{padding:10px 14px;font-size:10px;font-weight:700;color:var(--slate-500);text-transform:uppercase;letter-spacing:.4px;border-bottom:1px solid var(--slate-200);white-space:nowrap;text-align:left}
.xo-table td{padding:12px 14px;font-size:12px;color:var(--slate-900);border-bottom:1px solid var(--slate-100);vertical-align:middle}
.xo-table tbody tr{transition:background .12s}
.xo-table tbody tr:hover{background:var(--slate-50)}
.xo-table tbody tr:last-child td{border-bottom:none}

/* ══ User Avatar ══ */
.xo-av{width:36px;height:36px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:12px;color:#fff;border:1.5px solid var(--slate-200);overflow:hidden;background:linear-gradient(135deg,#1a202c,#334155)}
.xo-av img{width:100%;height:100%;object-fit:cover;border-radius:50%}

/* ══ Hashtag bar ══ */
.xo-ht-bar{height:6px;border-radius:3px;background:var(--slate-100);overflow:hidden;min-width:60px}
.xo-ht-bar-fill{height:100%;border-radius:3px;background:linear-gradient(90deg,var(--dash-primary),var(--dash-primary-dark));transition:width .6s}

/* ══ Map ══ */
.xo-map{height:360px;border-radius:var(--radius-xs);overflow:hidden;z-index:1}

/* ══ Sent badges ══ */
.xo-sent{display:inline-flex;align-items:center;padding:2px 8px;border-radius:20px;font-size:9.5px;font-weight:800;text-transform:uppercase;letter-spacing:.3px}
.xo-sent--pos{background:#d1fae5;color:#065f46}
.xo-sent--neg{background:#fee2e2;color:#991b1b}
.xo-sent--neu{background:var(--slate-100);color:var(--slate-500)}

/* ══ Pagination ══ */
.xo-pag{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-top:1px solid var(--slate-100);flex-wrap:wrap;gap:10px}
.xo-pag-info{font-size:12px;color:var(--slate-400);font-weight:500}
.xo-pag-ctrls{display:flex;align-items:center;gap:4px}
.xo-pag-btn{min-width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;padding:0 8px;border-radius:var(--radius-xs);border:1px solid var(--slate-200);background:#fff;font-family:var(--font);font-size:12px;font-weight:600;color:var(--slate-500);cursor:pointer;transition:all .15s;user-select:none}
.xo-pag-btn:hover:not(:disabled):not(.is-active){border-color:var(--dash-primary);color:var(--dash-primary);background:var(--dash-primary-lt)}
.xo-pag-btn.is-active{background:var(--dash-primary);border-color:var(--dash-primary);color:#fff}
.xo-pag-btn:disabled{opacity:.4;cursor:not-allowed}
.xo-pag-btn svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

/* ══ Empty & Loading ══ */
.xo-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:56px 20px;gap:10px}
.xo-empty svg{width:40px;height:40px;stroke:var(--slate-300);fill:none;stroke-width:1.5}
.xo-empty-text{font-size:13px;font-weight:600;color:var(--slate-500)}
.xo-loading{display:flex;flex-direction:column;align-items:center;justify-content:center;padding:56px 20px;gap:14px;color:var(--slate-500);font-size:13px;font-weight:500}

/* ══ URL type badges ══ */
.xo-url-type{padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;text-transform:uppercase}

/* ══ Export button ══ */
.xo-export-btn{display:flex;align-items:center;gap:5px;padding:6px 14px;background:var(--slate-100);border:1px solid var(--slate-200);border-radius:var(--radius-xs);font-family:var(--font);font-size:12px;font-weight:600;color:var(--slate-500);cursor:pointer;transition:all .15s;white-space:nowrap}
.xo-export-btn:hover{background:var(--dash-primary);border-color:var(--dash-primary);color:#fff}
.xo-export-btn svg{width:12px;height:12px;stroke:currentColor;fill:none;stroke-width:2.2}

/* ══ Alert ══ */
.xo-alert{padding:16px 20px;border-radius:var(--radius-sm);margin-bottom:24px;font-size:14px;font-weight:500;display:flex;align-items:center;gap:12px;background:#fef3c7;color:#92400e;border:1px solid #fcd34d}

/* ══ Mention Modal ══ */
.xo-mention-modal{position:fixed;inset:0;z-index:10000;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.6);backdrop-filter:blur(8px)}
.xo-mention-modal.show{display:flex}
.xo-mm-overlay{position:absolute;inset:0}
.xo-mm-content{position:relative;z-index:1;background:#fff;border-radius:var(--radius);box-shadow:0 25px 50px rgba(0,0,0,.4);width:90%;max-width:560px;max-height:85vh;display:flex;flex-direction:column;animation:fadeUp .3s ease-out}
.xo-mm-header{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;border-bottom:1px solid var(--slate-200);background:var(--slate-50);border-radius:var(--radius) var(--radius) 0 0}
.xo-mm-header h3{font-size:16px;font-weight:700;color:var(--slate-900)}
.xo-mm-close{width:32px;height:32px;border-radius:var(--radius-xs);border:none;background:transparent;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--slate-500);transition:all .15s}
.xo-mm-close:hover{background:#fee2e2;color:#dc2626}
.xo-mm-body{padding:20px 24px;overflow-y:auto;flex:1}
.xo-mm-item{padding:14px 0;border-bottom:1px solid var(--slate-100)}
.xo-mm-item:last-child{border-bottom:none}
.xo-mm-item-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px}
.xo-mm-item-meta{font-size:12px;color:var(--slate-400);font-weight:500}
.xo-mm-item-text{font-size:13px;color:var(--slate-700);line-height:1.65}

/* ══ Responsive ══ */
@media(max-width:1200px){.xo-kpi-grid{grid-template-columns:repeat(2,1fr)}.xo-grid-2,.xo-grid-3{grid-template-columns:1fr}}
@media(max-width:768px){
  .xo-page{padding:16px}.xo-kpi-grid{grid-template-columns:1fr}
  .dp-container{flex-direction:column;width:96%}.dp-sidebar{width:100%;flex-direction:row;overflow-x:auto;border-right:none;border-bottom:1px solid var(--slate-200);border-radius:var(--radius) var(--radius) 0 0}
  .dp-preset{white-space:nowrap}.dp-cals{flex-direction:column}
}
</style>
@endsection

@section('content')
@php
